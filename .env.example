# Square API Configuration
SQUARE_ACCESS_TOKEN=your_square_access_token_here
SQUARE_LOCATION_ID=LRG8TDY17X9VD
SQUARE_FETCH_LIMIT=70

# Cloudflare D1 output (required when using --output d1)
D1_SYNC_URL=https://t125-roster.<your-subdomain>.workers.dev/api/sync
D1_SYNC_TOKEN=

# Square environment: sandbox (default) or production
SQUARE_ENVIRONMENT=sandbox

# Sandbox credentials. Square issues separate tokens AND separate location IDs
# per environment -- a production token will not work against sandbox.
SQUARE_SANDBOX_ACCESS_TOKEN=
SQUARE_SANDBOX_LOCATION_ID=
